<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".Suppliers.SupplyBid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Supplier Bid Submission"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:gravity="center"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="15dp"/>

                <!-- Request ID -->
                <TextView
                    android:id="@+id/txt_request_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request ID: #123"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#424242"/>

                <!-- Quantity -->
                <TextView
                    android:id="@+id/txt_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantity Needed: 0 Units"
                    android:textSize="15sp"
                    android:textColor="#616161"
                    android:layout_marginTop="6dp"/>

                <!-- Urgency -->
                <TextView
                    android:id="@+id/txt_urgency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgency: High"
                    android:textSize="15sp"
                    android:textColor="#E65100"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/txt_bid_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Apprved"
                    android:textSize="15sp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="6dp"/>

                <!-- Unit Price Input -->
                <TextView
                    android:id="@+id/txv_unit_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit Price"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp"
                    android:textColor="#37474F"/>


                <!-- Total Price -->
                <TextView
                    android:id="@+id/txv_total_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Price"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp"
                    android:textColor="#37474F"/>

                <Button
                    android:visibility="gone"
                    android:id="@+id/btn_view_payment"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="View Payment Receipt"
                    android:textStyle="bold"
                    android:backgroundTint="#00897B"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="12dp"/>


                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="25dp"
                    android:visibility="gone"/>

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btn_supply"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Supply"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#1565C0"
                    android:layout_marginTop="22dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>